{
  "name": "tokeneconomizer",
  "version": "0.1.0",
  "displayName": "TokenEconomizer",
  "description": "Experience-driven black-box cost control for coding agents: micro-skills (short repository facts learned from earlier sessions) injected at session start, tool pruning that leaves out tools a repository's sessions never use (one command gives them back), and a guard that redirects a turn stuck in a failing loop.",
  "author": {
    "name": "TokenEconomizer authors"
  },
  "repository": "https://github.com/nektomk/TokenEconomizer",
  "license": "Apache-2.0",
  "commandsDir": "commands",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/te-hook --host qwen || ${CLAUDE_PLUGIN_ROOT}/scripts/te-hook.cmd --host qwen",
            "name": "tokeneconomizer-session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/te-hook --host qwen || ${CLAUDE_PLUGIN_ROOT}/scripts/te-hook.cmd --host qwen",
            "name": "tokeneconomizer-user-prompt-submit",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/te-hook --host qwen || ${CLAUDE_PLUGIN_ROOT}/scripts/te-hook.cmd --host qwen",
            "name": "tokeneconomizer-post-tool-use",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/te-hook --host qwen || ${CLAUDE_PLUGIN_ROOT}/scripts/te-hook.cmd --host qwen",
            "name": "tokeneconomizer-post-tool-use-failure",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/te-hook --host qwen || ${CLAUDE_PLUGIN_ROOT}/scripts/te-hook.cmd --host qwen",
            "name": "tokeneconomizer-stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/te-hook --host qwen || ${CLAUDE_PLUGIN_ROOT}/scripts/te-hook.cmd --host qwen",
            "name": "tokeneconomizer-session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
